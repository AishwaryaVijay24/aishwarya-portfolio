# Docker Compose settings. Copy to .env to override the defaults; never commit .env.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio
# Host ports (change any that are already in use on your machine).
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
APP_ENV=development
# Public address of the site (used in link previews).
SITE_URL=http://localhost:3000
# Re-load backend/app/seed/portfolio.json on every backend start.
SEED_ON_START=true
