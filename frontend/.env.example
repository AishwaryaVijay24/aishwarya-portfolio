# Base URL of the FastAPI backend, used by Next.js on the server.
# The browser never calls the backend directly.
# Local development: http://localhost:8000
# Docker Compose (later in Phase 1): http://backend:8000
API_BASE_URL=http://localhost:8000

# Public address of the site, used for absolute URLs in link previews.
SITE_URL=http://localhost:3000
